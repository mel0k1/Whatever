class Window {
	private struct browser_window * win;
	private struct html_content * htmlc;
	private struct window_schedule_s * schedule_ring;
	private bool closed_down;
	prologue %{
#include "utils/corestrings.h"
#include "utils/nsurl.h"
#include "netsurf/browser_window.h"
#include "content/hlcache.h"
#include "html/html.h"
#include "html/private.h"
#include "desktop/gui_internal.h"
#include "netsurf/misc.h"
#include "utils/ring.h"
#include "netsurf/inttypes.h"
#include <string.h>
#include <stdio.h>
#include "css/select.h"
#include "css/utils.h"
#include "desktop/browser_private.h"
#include "content/handlers/html/box_inspect.h"
#include "netsurf/types.h"
#include "desktop/browser_history.h"
#include "utils/nsoption.h"

#define WINDOW_CALLBACKS MAGIC(WindowCallbacks)
#define HANDLER_MAGIC MAGIC(HANDLER_MAP)

void dukky_window_drain_microtasks(duk_context *ctx)
{
	duk_push_global_object(ctx);
	duk_get_prop_string(ctx, -1, "__drainTasks");
	if (duk_is_function(ctx, -1)) {
		(void)duk_pcall(ctx, 0);
	}
	duk_pop(ctx);
	duk_pop(ctx);
}

static size_t next_handle = 0;

typedef struct window_schedule_s {
	window_private_t *owner;
	duk_context *ctx;
	struct window_schedule_s *r_next;
	struct window_schedule_s *r_prev;
	size_t handle;
	int repeat_timeout;
	bool running;
} window_schedule_t;

static void window_remove_callback_bits(duk_context *ctx, size_t handle) {
	/* stack is ... */
	duk_push_global_object(ctx);
	duk_get_prop_string(ctx, -1, WINDOW_CALLBACKS);
	/* stack is ..., win, cbt */
	duk_push_int(ctx, (duk_int_t)handle);
	/* ..., win, cbt, handle */
	duk_del_prop(ctx, -2);
	/* ..., win, cbt */
	duk_pop_2(ctx);
	/* ... */
}

static void
window_call_callback(duk_context *ctx, size_t handle, bool clear_entry)
{
	NSLOG(dukky, DEEPDEBUG, "ctx=%p, handle=%"PRIsizet, ctx, handle);
	/* Stack is ... */
	duk_push_global_object(ctx);
	/* ..., win */
	duk_get_prop_string(ctx, -1, WINDOW_CALLBACKS);
	/* ..., win, cbt */
	duk_push_int(ctx, (duk_int_t)handle);
	/* ..., win, cbt, handle */
	duk_get_prop(ctx, -2);
	/* ..., win, cbt, cbo */
	//dukky_log_stack_frame(ctx, "On entry to callback");
	/* ..., win, cbt, cbo */
	/* What we want to do is call cbo.func passing all of cbo.args */
	duk_get_prop_string(ctx, -1, "func");
	duk_get_prop_string(ctx, -2, "args");
	/* ..., win, cbt, cbo, func, argarr */
	duk_size_t arrlen = duk_get_length(ctx, -1);
	for (duk_size_t i = 0; i < arrlen; ++i) {
		duk_push_int(ctx, (duk_int_t)i);
		duk_get_prop(ctx, -(2+i));
	}
	/* ..., win, cbt, cbo, func, argarr, args... */
	duk_remove(ctx, -(arrlen+1));
	/* ..., win, cbt, cbo, func, args... */
	//dukky_log_stack_frame(ctx, "Just before call");
	(void) dukky_pcall(ctx, arrlen, true);
	/* ..., win, cbt, cbo, retval */
	if (clear_entry) {
		NSLOG(dukky, DEEPDEBUG, "Not recurring callback, removing from cbt");
		duk_pop_n(ctx, 2);
		/* ..., win, cbt */
		duk_push_int(ctx, (duk_int_t)handle);
		/* ..., win, cbt, handle */
		duk_del_prop(ctx, -2);
		/* ..., win, cbt */
		duk_pop_n(ctx, 2);
	} else {
		duk_pop_n(ctx, 4);
	}
	/* ... */
	//dukky_log_stack_frame(ctx, "On leaving callback");
}


static void
window_schedule_callback(void *p)
{
	window_schedule_t *priv = (window_schedule_t *)p;

	NSLOG(dukky, DEEPDEBUG,
	      "Entered window scheduler callback: %"PRIsizet, priv->handle);

	priv->running = true;
	window_call_callback(priv->ctx,
			     priv->handle,
			     priv->repeat_timeout == 0);
	priv->running = false;
	dukky_window_drain_microtasks(priv->ctx);
	html_schedule_reformat(priv->owner->htmlc);

	if (priv->repeat_timeout > 0) {
		/* Reschedule */
		NSLOG(dukky, DEEPDEBUG,
		      "Rescheduling repeating callback %"PRIsizet,
		      priv->handle);
		guit->misc->schedule(priv->repeat_timeout,
				     window_schedule_callback,
				     priv);
	} else {
		NSLOG(dukky, DEEPDEBUG,
		      "Removing completed callback %"PRIsizet, priv->handle);
		/* Remove this from the ring */
		RING_REMOVE(priv->owner->schedule_ring, priv);
		window_remove_callback_bits(priv->ctx, priv->handle);
		free(priv);
	}
}

static size_t
window_alloc_new_callback(duk_context *ctx,
			  window_private_t *window,
			  bool repeating,
			  int timeout)
{
	size_t new_handle = next_handle++;
	window_schedule_t *sched = calloc(1, sizeof *sched);
	if (sched == NULL) {
		return new_handle;
	}
	sched->owner = window;
	sched->ctx = ctx;
	sched->handle = new_handle;
	sched->repeat_timeout = repeating ? timeout : 0;
	sched->running = false;

	RING_INSERT(window->schedule_ring, sched);

	/* Next, the duktape stack looks like: func, timeout, ...
	 * In order to proceed, we want to put into the WINDOW_CALLBACKS
	 * keyed by the handle, an object containing the call to make and
	 * the array of arguments to call the function with
	 */
	duk_idx_t nargs = duk_get_top(ctx) - 2;
	duk_push_global_object(ctx);
	duk_get_prop_string(ctx, -1, WINDOW_CALLBACKS);
	duk_push_int(ctx, (duk_int_t)new_handle);
	duk_push_object(ctx);
	/* stack is: func, timeout, ..., win, cbt, handle, cbo */

	/* put the function into the cbo */
	duk_dup(ctx, 0);
	duk_put_prop_string(ctx, -2, "func");

	/* Now the arguments */
	duk_push_array(ctx);
	for (duk_idx_t i = 0; i < nargs; ++i) {
		duk_dup(ctx, 2 + i); /* Dup the arg */
		duk_put_prop_index(ctx, -2, i); /* arr[i] = arg[i] */
	}
	duk_put_prop_string(ctx, -2, "args");
	/* stack is: func, timeout, ..., win, cbt, handle, cbo */
	duk_put_prop(ctx, -3);
	/* stack is: func, timeout, ..., win, cbt */
	duk_pop_2(ctx);
	/* And we're back to func, timeout, ... */

	guit->misc->schedule(timeout, window_schedule_callback, sched);
	NSLOG(dukky, DEEPDEBUG, "Scheduled callback %"PRIsizet" for %d ms from now", new_handle, timeout);

	return new_handle;
}

static void
window_remove_callback_by_handle(duk_context *ctx,
				 window_private_t *window,
				 size_t handle)
{
	int res;

	RING_ITERATE_START(window_schedule_t, window->schedule_ring, sched) {
		if (sched->handle == handle) {
			if (sched->running) {
				NSLOG(dukky, DEEPDEBUG,
				      "Cancelling in-train callback %"PRIsizet,
				      sched->handle);
				sched->repeat_timeout = 0;
			} else {
				NSLOG(dukky, DEEPDEBUG,
				      "Cancelled callback %"PRIsizet,
				      sched->handle);
				res = guit->misc->schedule(-1,
							   window_schedule_callback,
							   sched);
				assert(res == NSERROR_OK);
				RING_REMOVE(window->schedule_ring, sched);
				window_remove_callback_bits(ctx, sched->handle);
				free(sched);
			}
			RING_ITERATE_STOP(window->schedule_ring, sched);
		}
	} RING_ITERATE_END(window->schedule_ring, sched);
}

/* This is the dodgy thread closedown method */
static duk_ret_t dukky_window_closedown_thread(duk_context *ctx)
{
	window_private_t *priv = NULL;

	duk_push_global_object(ctx);
	duk_get_prop_string(ctx, -1, dukky_magic_string_private);
	priv = duk_get_pointer(ctx, -1);
	duk_pop_2(ctx);

	if (priv == NULL) {
		return 0;
	}

	priv->closed_down = true;

	NSLOG(dukky, DEEPDEBUG, "Closing down thread");
	while (priv->schedule_ring != NULL) {
		window_schedule_t *to_remove = NULL;
		// Find a schedule item to remove
		RING_ITERATE_START(window_schedule_t, priv->schedule_ring, sched) {
			if (sched->running == false) {
				// This one is not running, we can remove it
				to_remove = sched;
				RING_ITERATE_STOP(window->schedule_ring, sched);
			} else if (sched->repeat_timeout != 0) {
				// This one is running and has yet to be
				// cancelled, so prevent it rescheduling itself
				NSLOG(dukky, DEEPDEBUG,
				      "Cancelling in-train callback %"PRIsizet,
				      sched->handle);
				sched->repeat_timeout = 0;
			}
		} RING_ITERATE_END(priv->schedule_ring, sched);

		if (to_remove == NULL) {
			// We didn't find any non-running callbacks
			// so let's log that and break out of the closedown
			// loop so we can continue and hopefully close down
			NSLOG(dukky, DEEPDEBUG,
			      "Leaving in-train callbacks to unwind");
			break;
		}
		
		// Remove the handle we found, this will reduce the callback
		// scheduler ring by one and perhaps leave it empty so we can
		// finish the closedown.
		window_remove_callback_by_handle(ctx,
						 priv,
						 to_remove->handle);
	}

	return 0;
}

void dukky_window_reformat_request(duk_context *ctx)
{
	window_private_t *winpriv = NULL;
	duk_push_global_object(ctx);
	duk_get_prop_string(ctx, -1, dukky_magic_string_private);
	winpriv = duk_get_pointer(ctx, -1);
	duk_pop_2(ctx);
	if (winpriv != NULL && winpriv->htmlc != NULL) {
		html_schedule_reformat(winpriv->htmlc);
	}
}


static const char *dukky_window_unit_str(css_unit unit)
{
	switch (unit) {
	case CSS_UNIT_EX: return "ex";
	case CSS_UNIT_EM: return "em";
	case CSS_UNIT_IN: return "in";
	case CSS_UNIT_CM: return "cm";
	case CSS_UNIT_MM: return "mm";
	case CSS_UNIT_PT: return "pt";
	case CSS_UNIT_PC: return "pc";
	case CSS_UNIT_CH: return "ch";
	case CSS_UNIT_REM: return "rem";
	case CSS_UNIT_LH: return "lh";
	case CSS_UNIT_VH: return "vh";
	case CSS_UNIT_VW: return "vw";
	case CSS_UNIT_VI: return "vi";
	case CSS_UNIT_VB: return "vb";
	case CSS_UNIT_VMIN: return "vmin";
	case CSS_UNIT_VMAX: return "vmax";
	case CSS_UNIT_Q: return "q";
	case CSS_UNIT_PCT: return "%";
	case CSS_UNIT_PX:
	default: return "px";
	}
}

static void dukky_window_fmt_num(char *out, size_t outlen, double v)
{
	size_t l;
	snprintf(out, outlen, "%.3f", v);
	l = strlen(out);
	while (l > 1 && out[l - 1] == '0') {
		out[--l] = '\0';
	}
	if (l > 1 && out[l - 1] == '.') {
		out[--l] = '\0';
	}
	if (strcmp(out, "-0") == 0) {
		snprintf(out, outlen, "0");
	}
}

static void dukky_window_push_dim(duk_context *ctx, const char *name,
		css_fixed len, css_unit unit)
{
	char buf[56];
	size_t l;
	dukky_window_fmt_num(buf, sizeof buf, ((double)len) / 256.0);
	l = strlen(buf);
	snprintf(buf + l, sizeof buf - l, "%s", dukky_window_unit_str(unit));
	duk_push_string(ctx, buf);
	duk_put_prop_string(ctx, -2, name);
}

static void dukky_window_push_color(duk_context *ctx, const char *name,
		css_color color)
{
	char buf[64];
	unsigned int a = (color >> 24) & 0xFF;
	unsigned int r = (color >> 16) & 0xFF;
	unsigned int g = (color >> 8) & 0xFF;
	unsigned int b = color & 0xFF;
	if (a == 0xFF) {
		snprintf(buf, sizeof buf, "#%02x%02x%02x", r, g, b);
	} else {
		char num[32];
		dukky_window_fmt_num(num, sizeof num, ((double)a) / 255.0);
		snprintf(buf, sizeof buf, "rgba(%u, %u, %u, %s)", r, g, b, num);
	}
	duk_push_string(ctx, buf);
	duk_put_prop_string(ctx, -2, name);
}

static void dukky_window_style_put(duk_context *ctx, const char *name,
		const char *val)
{
	duk_push_string(ctx, val);
	duk_put_prop_string(ctx, -2, name);
}

static duk_ret_t dukky_window_style_get_prop(duk_context *ctx)
{
	const char *name;
	char norm[128];
	size_t i;
	size_t o = 0;
	name = duk_safe_to_string(ctx, 0);
	for (i = 0; name[i] != '\0' && o + 2 < sizeof norm; i++) {
		if (name[i] >= 'A' && name[i] <= 'Z') {
			norm[o++] = '-';
		}
		norm[o++] = (char)(name[i] | 0x20);
	}
	norm[o] = '\0';
	duk_push_this(ctx);
	duk_get_prop_string(ctx, -1, norm);
	if (duk_is_undefined(ctx, -1)) {
		duk_pop(ctx);
		duk_push_string(ctx, "");
	}
	return 1;
}

static duk_ret_t dukky_window_style_get_prio(duk_context *ctx)
{
	duk_push_string(ctx, "");
	return 1;
}

static const char *dukky_window_display_str(uint8_t d)
{
	switch (d) {
	case CSS_DISPLAY_NONE: return "none";
	case CSS_DISPLAY_BLOCK: return "block";
	case CSS_DISPLAY_LIST_ITEM: return "list-item";
	case CSS_DISPLAY_RUN_IN: return "run-in";
	case CSS_DISPLAY_INLINE_BLOCK: return "inline-block";
	case CSS_DISPLAY_TABLE: return "table";
	case CSS_DISPLAY_INLINE_TABLE: return "inline-table";
	case CSS_DISPLAY_TABLE_ROW_GROUP: return "table-row-group";
	case CSS_DISPLAY_TABLE_HEADER_GROUP: return "table-header-group";
	case CSS_DISPLAY_TABLE_FOOTER_GROUP: return "table-footer-group";
	case CSS_DISPLAY_TABLE_ROW: return "table-row";
	case CSS_DISPLAY_TABLE_COLUMN_GROUP: return "table-column-group";
	case CSS_DISPLAY_TABLE_COLUMN: return "table-column";
	case CSS_DISPLAY_TABLE_CELL: return "table-cell";
	case CSS_DISPLAY_TABLE_CAPTION: return "table-caption";
	case CSS_DISPLAY_FLEX: return "flex";
	case CSS_DISPLAY_INLINE_FLEX: return "inline-flex";
	case CSS_DISPLAY_GRID: return "grid";
	case CSS_DISPLAY_INLINE_GRID: return "inline-grid";
	case CSS_DISPLAY_INLINE:
	default: return "inline";
	}
}

static css_stylesheet *dukky_window_inline_style(struct html_content *htmlc,
		dom_node *n)
{
	dom_string *s = NULL;
	css_stylesheet *st;
	dom_exception err;

	err = dom_element_get_attribute((dom_element *)n,
			corestring_dom_style, &s);
	if (err != DOM_NO_ERR) {
		return NULL;
	}
	if (s == NULL) {
		return NULL;
	}
	st = nscss_create_inline_style(
			(const uint8_t *)dom_string_data(s),
			dom_string_byte_length(s),
			htmlc->encoding,
			nsurl_access(htmlc->base_url),
			htmlc->quirks != DOM_DOCUMENT_QUIRKS_MODE_NONE);
	dom_string_unref(s);
	return st;
}

static const char *dukky_window_border_style_str(uint8_t v)
{
	switch (v) {
	case CSS_BORDER_STYLE_HIDDEN: return "hidden";
	case CSS_BORDER_STYLE_DOTTED: return "dotted";
	case CSS_BORDER_STYLE_DASHED: return "dashed";
	case CSS_BORDER_STYLE_SOLID: return "solid";
	case CSS_BORDER_STYLE_DOUBLE: return "double";
	case CSS_BORDER_STYLE_GROOVE: return "groove";
	case CSS_BORDER_STYLE_RIDGE: return "ridge";
	case CSS_BORDER_STYLE_INSET: return "inset";
	case CSS_BORDER_STYLE_OUTSET: return "outset";
	case CSS_BORDER_STYLE_NONE:
	default: return "none";
	}
}

static void dukky_window_border_width(duk_context *ctx, const char *name,
		uint8_t kind, css_fixed len, css_unit unit)
{
	switch (kind) {
	case CSS_BORDER_WIDTH_WIDTH:
		dukky_window_push_dim(ctx, name, len, unit);
		break;
	case CSS_BORDER_WIDTH_THIN:
		dukky_window_style_put(ctx, name, "1px");
		break;
	case CSS_BORDER_WIDTH_THICK:
		dukky_window_style_put(ctx, name, "5px");
		break;
	case CSS_BORDER_WIDTH_MEDIUM:
	default:
		dukky_window_style_put(ctx, name, "3px");
		break;
	}
}


static window_private_t *dukky_window_priv(duk_context *ctx)
{
	window_private_t *priv;
	duk_push_global_object(ctx);
	duk_get_prop_string(ctx, -1, PRIVATE_MAGIC);
	priv = (window_private_t *)duk_get_pointer(ctx, -1);
	duk_pop_2(ctx);
	return priv;
}

static dom_node *dukky_ns_node_arg(duk_context *ctx, duk_idx_t idx)
{
	node_private_t *np;
	if (!duk_is_object(ctx, idx)) {
		return NULL;
	}
	duk_get_prop_string(ctx, idx, PRIVATE_MAGIC);
	np = (node_private_t *)duk_get_pointer(ctx, -1);
	duk_pop(ctx);
	if (np == NULL) {
		return NULL;
	}
	return np->node;
}

static struct box *dukky_box_for_node(struct box *b, dom_node *n)
{
	struct box *r;
	if (b == NULL) {
		return NULL;
	}
	if (b->node != NULL) {
		bool same = false;
		if (dom_node_is_same(b->node, n, &same) == DOM_NO_ERR && same) {
			return b;
		}
	}
	r = dukky_box_for_node(b->children, n);
	if (r != NULL) {
		return r;
	}
	return dukky_box_for_node(b->float_children, n);
}

static duk_ret_t dukky_ns_metrics(duk_context *ctx)
{
	window_private_t *priv = dukky_window_priv(ctx);
	int w = 0;
	int h = 0;
	int sx = 0;
	int sy = 0;
	if (priv != NULL && priv->win != NULL) {
		browser_window_get_dimensions(priv->win, &w, &h);
		if (priv->win->window != NULL) {
			guit->window->get_scroll(priv->win->window, &sx, &sy);
		}
	}
	duk_push_object(ctx);
	duk_push_int(ctx, w);
	duk_put_prop_string(ctx, -2, "innerWidth");
	duk_push_int(ctx, h);
	duk_put_prop_string(ctx, -2, "innerHeight");
	duk_push_int(ctx, w);
	duk_put_prop_string(ctx, -2, "outerWidth");
	duk_push_int(ctx, h);
	duk_put_prop_string(ctx, -2, "outerHeight");
	duk_push_int(ctx, sx);
	duk_put_prop_string(ctx, -2, "scrollX");
	duk_push_int(ctx, sy);
	duk_put_prop_string(ctx, -2, "scrollY");
	duk_push_int(ctx, 1);
	duk_put_prop_string(ctx, -2, "devicePixelRatio");
	return 1;
}

static duk_ret_t dukky_ns_rect(duk_context *ctx)
{
	window_private_t *priv = dukky_window_priv(ctx);
	dom_node *n = dukky_ns_node_arg(ctx, 0);
	struct html_content *htmlc = NULL;
	struct box *box = NULL;
	struct rect bounds;
	dom_document *doc = NULL;
	dom_exception err;
	int sx = 0;
	int sy = 0;
	int x = 0;
	int y = 0;
	int w = 0;
	int h = 0;

	bounds.x0 = 0;
	bounds.y0 = 0;
	bounds.x1 = 0;
	bounds.y1 = 0;
	if (n != NULL) {
		err = dom_node_get_owner_document(n, &doc);
		if (err == DOM_NO_ERR && doc != NULL) {
			dom_node_get_user_data((dom_node *)doc,
					corestring_dom___ns_key_html_content_data,
					&htmlc);
			if (htmlc != NULL && htmlc->layout != NULL) {
				box = dukky_box_for_node(htmlc->layout, n);
			}
		}
		if (doc != NULL) {
			dom_node_unref((dom_node *)doc);
		}
	}
	if (box != NULL) {
		box_bounds(box, &bounds);
		x = bounds.x0;
		y = bounds.y0;
		w = bounds.x1 - bounds.x0;
		h = bounds.y1 - bounds.y0;
	}
	if (priv != NULL && priv->win != NULL && priv->win->window != NULL) {
		guit->window->get_scroll(priv->win->window, &sx, &sy);
	}
	duk_push_object(ctx);
	duk_push_int(ctx, x - sx);
	duk_put_prop_string(ctx, -2, "x");
	duk_push_int(ctx, y - sy);
	duk_put_prop_string(ctx, -2, "y");
	duk_push_int(ctx, x - sx);
	duk_put_prop_string(ctx, -2, "left");
	duk_push_int(ctx, y - sy);
	duk_put_prop_string(ctx, -2, "top");
	duk_push_int(ctx, x - sx + w);
	duk_put_prop_string(ctx, -2, "right");
	duk_push_int(ctx, y - sy + h);
	duk_put_prop_string(ctx, -2, "bottom");
	duk_push_int(ctx, w);
	duk_put_prop_string(ctx, -2, "width");
	duk_push_int(ctx, h);
	duk_put_prop_string(ctx, -2, "height");
	return 1;
}


static char *dukky_storage_path(window_private_t *priv, const char *origin)
{
	const char *jar;
	size_t dirlen;
	unsigned long h = 2166136261ul;
	const char *p;
	char *fname;
	if (priv == NULL || priv->win == NULL) {
		return NULL;
	}
	jar = nsoption_charp(cookie_jar);
	if (jar == NULL || jar[0] == '\0') {
		return NULL;
	}
	dirlen = strlen(jar);
	while (dirlen > 0 && jar[dirlen - 1] != '/' && jar[dirlen - 1] != '\\') {
		dirlen--;
	}
	if (dirlen == 0) {
		return NULL;
	}
	for (p = origin; *p != '\0'; p++) {
		h ^= (unsigned char)*p;
		h *= 16777619ul;
	}
	fname = malloc(dirlen + 32);
	if (fname == NULL) {
		return NULL;
	}
	snprintf(fname, dirlen + 32, "%.*sstorage-%08lx.txt", (int)dirlen, jar, h);
	return fname;
}

static duk_ret_t dukky_ns_storage_read(duk_context *ctx)
{
	char *path;
	FILE *f;
	long len;
	size_t got;
	char *data;
	const char *origin = "";
	duk_size_t olen = 0;
	if (duk_get_top(ctx) > 0) {
		origin = duk_safe_to_lstring(ctx, 0, &olen);
	}
	path = dukky_storage_path(dukky_window_priv(ctx), origin);
	if (path == NULL) {
		duk_push_string(ctx, "");
		return 1;
	}
	f = fopen(path, "rb");
	free(path);
	if (f == NULL) {
		duk_push_string(ctx, "");
		return 1;
	}
	fseek(f, 0, SEEK_END);
	len = ftell(f);
	fseek(f, 0, SEEK_SET);
	if (len < 0 || len > 4194304) {
		fclose(f);
		duk_push_string(ctx, "");
		return 1;
	}
	data = malloc((size_t)len + 1);
	if (data == NULL) {
		fclose(f);
		duk_push_string(ctx, "");
		return 1;
	}
	got = fread(data, 1, (size_t)len, f);
	fclose(f);
	data[got] = '\0';
	duk_push_lstring(ctx, data, got);
	free(data);
	return 1;
}

static duk_ret_t dukky_ns_storage_write(duk_context *ctx)
{
	char *path;
	FILE *f;
	duk_size_t dlen = 0;
	const char *data = "";
	const char *origin = "";
	duk_size_t olen = 0;
	if (duk_get_top(ctx) > 0) {
		origin = duk_safe_to_lstring(ctx, 0, &olen);
	}
	if (duk_get_top(ctx) > 1) {
		data = duk_safe_to_lstring(ctx, 1, &dlen);
	}
	path = dukky_storage_path(dukky_window_priv(ctx), origin);
	if (path == NULL) {
		return 0;
	}
	if (dlen > 4194304) {
		dlen = 4194304;
	}
	f = fopen(path, "wb");
	free(path);
	if (f == NULL) {
		return 0;
	}
	if (dlen > 0) {
		fwrite(data, 1, dlen, f);
	}
	fclose(f);
	return 0;
}

static duk_ret_t dukky_ns_history_go(duk_context *ctx)
{
	window_private_t *priv = dukky_window_priv(ctx);
	int steps;
	int i;
	if (priv == NULL || priv->win == NULL) {
		return 0;
	}
	steps = (int)duk_to_int(ctx, 0);
	if (steps == 0) {
		browser_window_reload(priv->win, false);
		return 0;
	}
	if (steps < 0) {
		for (i = 0; i < -steps; i++) {
			if (browser_window_history_back(priv->win, false) != NSERROR_OK) {
				break;
			}
		}
	} else {
		for (i = 0; i < steps; i++) {
			if (browser_window_history_forward(priv->win, false) != NSERROR_OK) {
				break;
			}
		}
	}
	return 0;
}

void dukky_window_register_api(duk_context *ctx)
{
	duk_push_c_function(ctx, dukky_ns_metrics, 0);
	duk_put_global_string(ctx, "__nsMetrics");
	duk_push_c_function(ctx, dukky_ns_rect, 1);
	duk_put_global_string(ctx, "__nsRect");
	duk_push_c_function(ctx, dukky_ns_history_go, 1);
	duk_put_global_string(ctx, "__nsHistoryGo");
	duk_push_c_function(ctx, dukky_ns_storage_read, 1);
	duk_put_global_string(ctx, "__nsStorageRead");
	duk_push_c_function(ctx, dukky_ns_storage_write, 2);
	duk_put_global_string(ctx, "__nsStorageWrite");
}

%};
};

init Window(struct browser_window *win, struct html_content *htmlc)
%{
	/* It makes no sense if win or htmlc are NULL */
	assert(win != NULL);
	assert(htmlc != NULL);
	/* element window */
	priv->win = win;
	priv->htmlc = htmlc;
	priv->schedule_ring = NULL;
	priv->closed_down = false;
	NSLOG(netsurf, DEEPDEBUG, "win=%p htmlc=%p", priv->win, priv->htmlc);

	NSLOG(netsurf, DEEPDEBUG,
	      "URL is %s", nsurl_access(browser_window_access_url(priv->win)));
	duk_push_object(ctx);
	duk_put_prop_string(ctx, 0, WINDOW_CALLBACKS);
%}

fini Window()
%{
	NSLOG(dukky, DEEPDEBUG, "Shutting down Window %p", priv->win);
	/* Cheaply iterate the schedule ring, cancelling any pending callbacks */
	while (priv->schedule_ring != NULL) {
		window_remove_callback_by_handle(ctx, priv, priv->schedule_ring->handle);
	}
%}

prototype Window()
%{
#define EXPOSE(v) \
	duk_get_global_string(ctx, #v); \
	duk_put_prop_string(ctx, 0, #v)
	/* https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects */
	/* ** Value properties */
	EXPOSE(Infinity);
	EXPOSE(NaN);
	EXPOSE(undefined);
	EXPOSE(null);
	EXPOSE(globalThis);

	/* ** Function properties */
	EXPOSE(eval);
	/* EXPOSE(uneval); */ /* Not standard, maybe not available */
	EXPOSE(isFinite);
	EXPOSE(isNaN);
	EXPOSE(parseFloat);
	EXPOSE(parseInt);
	EXPOSE(decodeURI);
	EXPOSE(decodeURIComponent);
	EXPOSE(encodeURI);
	EXPOSE(encodeURIComponent);
	EXPOSE(escape);
	EXPOSE(unescape);

	/* ** Fundamental Objects */
	EXPOSE(Object);
	EXPOSE(Function);
	EXPOSE(Boolean);
	EXPOSE(Symbol);
	EXPOSE(Error);
	EXPOSE(EvalError);
	EXPOSE(InternalError);
	EXPOSE(RangeError);
	EXPOSE(ReferenceError);
	EXPOSE(SyntaxError);
	EXPOSE(TypeError);
	EXPOSE(URIError);

	/* ** Numbers and Dates */
	EXPOSE(Number);
	EXPOSE(BigInt);
	EXPOSE(Math);
	EXPOSE(Date);

	/* ** Text Processing */
	EXPOSE(String);
	EXPOSE(RegExp);

	/* ** Indexed Collections */
	EXPOSE(Array);
	EXPOSE(Int8Array);
	EXPOSE(Uint8Array);
	EXPOSE(Uint8ClampedArray);
	EXPOSE(Int16Array);
	EXPOSE(Uint16Array);
	EXPOSE(Int32Array);
	EXPOSE(Uint32Array);
	EXPOSE(Float32Array);
	EXPOSE(Float64Array);
	/* EXPOSE(BigInt64Array); */ /* Duktape lacks this - nonstandard API */
	/* EXPOSE(BigUint64Array); */ /* Duktape lacks this - nonstandard API */

	/* ** Keyed Collections */
	/* EXPOSE(Map); */ /* Duktape lacks this - ES6 */
	/* EXPOSE(Set); */ /* Duktape lacks this - ES6 */
	/* EXPOSE(WeakMap); */ /* Duktape lacks this - ES6 */
	/* EXPOSE(WeakSet); */ /* Duktape lacks this - ES6 */

	/* Structured Data */
	EXPOSE(ArrayBuffer);
	/* EXPOSE(SharedArrayBuffer); */ /* Duktape lacks this - experimental API */
	/* EXPOSE(Atomics); */ /* Duktape lacks this - experimental API */
	EXPOSE(DataView);
	EXPOSE(JSON);

	/* ** Control abstraction properties */
	/* EXPOSE(Promise); */ /* Probably ought to be one of ours? Also ES6 */
	/* EXPOSE(Generator); */ /* Duktape and async? ES6 */
	/* EXPOSE(GeneratorFunction); */ /* Duktape and async? ES6 */
	/* EXPOSE(AsyncFunction); */ /* Duktape lacks this - experimental API */

	/* Reflection */
	EXPOSE(Reflect);
	EXPOSE(Proxy);

	/* ** Internationalisation */
	/* Duktape lacks Intl - Maybe polyfill it? */
	/* There is suggestion that cdn.polyfill.io exists for it */

	/* ** WebAssembly */
	/* As yet, Duktape lacks WA */
#undef EXPOSE
	/* Add s3kr1t method to close the JS thread (browsing context) */
	duk_dup(ctx, 0);
	duk_push_string(ctx, MAGIC(closedownThread));
	duk_push_c_function(ctx, dukky_window_closedown_thread, DUK_VARARGS);
	duk_def_prop(ctx, -3,
		     DUK_DEFPROP_HAVE_VALUE |
		     DUK_DEFPROP_HAVE_WRITABLE |
		     DUK_DEFPROP_HAVE_ENUMERABLE |
		     DUK_DEFPROP_ENUMERABLE |
		     DUK_DEFPROP_HAVE_CONFIGURABLE);
	duk_pop(ctx);
%}

getter Window::document()
%{
	NSLOG(netsurf, DEBUG, "priv=%p", priv);
	dom_document *doc = priv->htmlc->document;
	dukky_push_node(ctx, (struct dom_node *)doc);
	return 1;
%}

getter Window::window()
%{
	duk_push_this(ctx);
	return 1;
%}

getter Window::console()
%{
	duk_push_this(ctx);
	duk_get_prop_string(ctx, -1, MAGIC(Console));
	if (duk_is_undefined(ctx, -1)) {
		duk_pop(ctx);
		if (dukky_create_object(ctx, PROTO_NAME(CONSOLE), 0) != DUK_EXEC_SUCCESS) {
			return duk_error(ctx, DUK_ERR_ERROR, "Unable to create console object");
		}
		duk_dup(ctx, -1);
		duk_put_prop_string(ctx, -3, MAGIC(Console));
	}
	return 1;
%}

getter Window::location()
%{
	/* obtain location object for this window (if it exists) */
	duk_push_this(ctx);
	duk_get_prop_string(ctx, -1, MAGIC(Location));
	if (duk_is_undefined(ctx, -1)) {
		/* location object did not previously exist so create it */
		duk_pop(ctx);

		duk_push_pointer(ctx, llcache_handle_get_url(priv->htmlc->base.llcache));

		if (dukky_create_object(ctx, PROTO_NAME(LOCATION), 1) != DUK_EXEC_SUCCESS) {
			return duk_error(ctx, DUK_ERR_ERROR, "Unable to create location object");
		}
		duk_dup(ctx, -1);
		duk_put_prop_string(ctx, -3, MAGIC(Location));
	}
	return 1;
%}

getter Window::navigator()
%{
	duk_push_this(ctx);
	duk_get_prop_string(ctx, -1, MAGIC(Navigator));
	if (duk_is_undefined(ctx, -1)) {
		duk_pop(ctx);

		if (dukky_create_object(ctx,
					PROTO_NAME(NAVIGATOR),
					0) != DUK_EXEC_SUCCESS) {
			return duk_error(ctx,
				  DUK_ERR_ERROR,
				  "Unable to create navigator object");
		}
		duk_dup(ctx, -1);
		duk_put_prop_string(ctx, -3, MAGIC(Navigator));
	}
	return 1;
%}

getter Window::name()
%{
	const char *name;
	browser_window_get_name(priv->win, &name);
	duk_push_string(ctx, name);
	return 1;
%}

setter Window::name()
%{
	const char *name;
	name = duk_to_string(ctx, -1);
	browser_window_set_name(priv->win, name);
	return 0;
%}

method Window::alert()
%{
	duk_idx_t dukky_argc = duk_get_top(ctx);
	if (dukky_argc == 0) {
		NSLOG(netsurf, INFO, "JS ALERT");
	} else {
		duk_size_t msg_len;
		const char *msg;

		if (!duk_is_string(ctx, 0)) {
			duk_to_string(ctx, 0);
		}
		msg = duk_safe_to_lstring(ctx, 0, &msg_len);
		NSLOG(netsurf, INFO, "JS ALERT: %*s", (int)msg_len, msg);
	}
	return 0;
%}

method Window::setTimeout()
%{
	duk_idx_t argc = duk_get_top(ctx);
	duk_int_t timeout = 10;

	if (priv->closed_down == true) {
		return 0; /* coerced to undefined */
	}

	if (argc >= 2) {
		timeout = duk_get_int(ctx, 1);
	}
	/* func, [timeout, args...] */
	if (timeout < 10) { timeout = 10; }
	size_t handle = window_alloc_new_callback(ctx, priv, false, (int)timeout);

	duk_push_int(ctx, (duk_int_t)handle);
	return 1;
%}

method Window::setInterval()
%{
	duk_idx_t argc = duk_get_top(ctx);
	duk_int_t timeout = 10;

	if (priv->closed_down == true) {
		return 0; /* coerced to undefined */
	}

	if (argc >= 2) {
		timeout = duk_get_int(ctx, 1);
	}
	/* func, [timeout, args...] */
	if (timeout < 10) { timeout = 10; }
	size_t handle = window_alloc_new_callback(ctx, priv, true, (int)timeout);

	duk_push_int(ctx, (duk_int_t)handle);
	return 1;
%}

method Window::clearTimeout()
%{
	duk_int_t handle = duk_get_int(ctx, 0);
	window_remove_callback_by_handle(ctx, priv, (size_t) handle);

	return 0;
%}

method Window::clearInterval()
%{
	duk_int_t handle = duk_get_int(ctx, 0);
	window_remove_callback_by_handle(ctx, priv, (size_t) handle);

	return 0;
%}

method Window::getComputedStyle()
%{
	node_private_t *npriv = NULL;
	struct html_content *htmlc = priv->htmlc;
	dom_node *chain[64];
	int depth = 0;
	dom_node *cur;
	dom_node *parent;
	css_select_results *res = NULL;
	css_select_results *prev = NULL;
	css_select_results *rootres = NULL;
	const css_computed_style *parent_style = NULL;
	const css_computed_style *root_style = NULL;
	const css_computed_style *style = NULL;
	nscss_select_ctx sctx;
	css_stylesheet *inline_style;
	css_fixed len;
	css_unit unit;
	css_color col;
	lwc_string **fams;
	lwc_string **fam;
	lwc_string *burl;
	int32_t zi;
	css_fixed op;
	uint8_t td;
	char buf[512];
	char nbuf[48];
	const char *v;
	int i;
	bool root_el;

	if (htmlc == NULL || htmlc->select_ctx == NULL) {
		duk_push_null(ctx);
		return 1;
	}
	if (duk_get_top(ctx) < 1 || !duk_is_object(ctx, 0)) {
		duk_push_null(ctx);
		return 1;
	}
	if (duk_get_top(ctx) > 1 && duk_is_string(ctx, 1) &&
	    duk_get_length(ctx, 1) > 0) {
		duk_push_null(ctx);
		return 1;
	}
	if (!dukky_instanceof(ctx, 0, PROTO_NAME(NODE))) {
		duk_push_null(ctx);
		return 1;
	}
	duk_get_prop_string(ctx, 0, PRIVATE_MAGIC);
	npriv = duk_get_pointer(ctx, -1);
	duk_pop(ctx);
	if (npriv == NULL || npriv->node == NULL) {
		duk_push_null(ctx);
		return 1;
	}
	cur = npriv->node;
	while (cur != NULL && depth < 64) {
		chain[depth++] = cur;
		parent = NULL;
		if (dom_node_get_parent_node(cur, &parent) != DOM_NO_ERR) {
			parent = NULL;
		}
		if (cur != npriv->node) {
			dom_node_unref(cur);
		}
		if (parent != NULL) {
			dom_node_type ptype = DOM_ELEMENT_NODE;
			if (dom_node_get_node_type(parent, &ptype) != DOM_NO_ERR ||
			    ptype != DOM_ELEMENT_NODE) {
				dom_node_unref(parent);
				parent = NULL;
			}
		}
		cur = parent;
	}
	if (cur != NULL && cur != npriv->node) {
		dom_node_unref(cur);
	}
	if (depth < 1) {
		duk_push_null(ctx);
		return 1;
	}
	for (i = depth - 1; i >= 0; i--) {
		inline_style = dukky_window_inline_style(htmlc, chain[i]);
		sctx.ctx = htmlc->select_ctx;
		sctx.quirks = (htmlc->quirks == DOM_DOCUMENT_QUIRKS_MODE_FULL);
		sctx.base_url = htmlc->base_url;
		sctx.universal = htmlc->universal;
		sctx.root_style = root_style;
		sctx.parent_style = parent_style;
		res = nscss_get_style(&sctx, chain[i], &htmlc->media,
				&htmlc->unit_len_ctx, inline_style);
		if (inline_style != NULL) {
			css_stylesheet_destroy(inline_style);
		}
		if (res == NULL) {
			if (prev != NULL && prev != rootres) {
				css_select_results_destroy(prev);
			}
			if (rootres != NULL) {
				css_select_results_destroy(rootres);
			}
			duk_push_null(ctx);
			return 1;
		}
		if (rootres == NULL) {
			rootres = res;
			root_style = res->styles[CSS_PSEUDO_ELEMENT_NONE];
		} else if (prev != NULL && prev != rootres) {
			css_select_results_destroy(prev);
		}
		prev = res;
		parent_style = res->styles[CSS_PSEUDO_ELEMENT_NONE];
	}
	if (prev == NULL || prev->styles[CSS_PSEUDO_ELEMENT_NONE] == NULL) {
		if (rootres != NULL) {
			css_select_results_destroy(rootres);
		}
		duk_push_null(ctx);
		return 1;
	}
	style = prev->styles[CSS_PSEUDO_ELEMENT_NONE];
	root_el = (depth == 1);

	duk_push_object(ctx);

	if (css_computed_color(style, &col) == CSS_COLOR_COLOR) {
		dukky_window_push_color(ctx, "color", col);
	} else {
		dukky_window_style_put(ctx, "color", "#000000");
	}

	switch (css_computed_background_color(style, &col)) {
	case CSS_BACKGROUND_COLOR_COLOR:
		dukky_window_push_color(ctx, "background-color", col);
		break;
	case CSS_BACKGROUND_COLOR_CURRENT_COLOR:
		dukky_window_style_put(ctx, "background-color", "currentcolor");
		break;
	default:
		dukky_window_style_put(ctx, "background-color", "rgba(0, 0, 0, 0)");
		break;
	}

	burl = NULL;
	if (css_computed_background_image(style, &burl) == CSS_BACKGROUND_IMAGE_IMAGE &&
	    burl != NULL) {
		duk_push_string(ctx, "url(\"");
		duk_push_lstring(ctx, (const char *)lwc_string_data(burl),
				lwc_string_length(burl));
		duk_push_string(ctx, "\")");
		duk_concat(ctx, 3);
		duk_put_prop_string(ctx, -2, "background-image");
	} else {
		dukky_window_style_put(ctx, "background-image", "none");
	}

	fams = NULL;
	if (css_computed_font_family(style, &fams) != CSS_FONT_FAMILY_INHERIT &&
	    fams != NULL && fams[0] != NULL) {
		size_t used = 0;
		buf[0] = '\0';
		for (fam = fams; *fam != NULL; fam++) {
			size_t l = lwc_string_length(*fam);
			if (used + l + 3 >= sizeof buf) {
				break;
			}
			if (used > 0) {
				buf[used++] = ',';
				buf[used++] = ' ';
			}
			memcpy(buf + used, lwc_string_data(*fam), l);
			used += l;
			buf[used] = '\0';
		}
		dukky_window_style_put(ctx, "font-family", buf);
	} else {
		switch (css_computed_font_family(style, &fams)) {
		case CSS_FONT_FAMILY_SANS_SERIF: v = "sans-serif"; break;
		case CSS_FONT_FAMILY_CURSIVE: v = "cursive"; break;
		case CSS_FONT_FAMILY_FANTASY: v = "fantasy"; break;
		case CSS_FONT_FAMILY_MONOSPACE: v = "monospace"; break;
		default: v = "serif"; break;
		}
		dukky_window_style_put(ctx, "font-family", v);
	}

	if (css_computed_font_size(style, &len, &unit) == CSS_FONT_SIZE_DIMENSION) {
		dukky_window_push_dim(ctx, "font-size", len, unit);
	} else {
		dukky_window_style_put(ctx, "font-size", "16px");
	}

	switch (css_computed_font_style(style)) {
	case CSS_FONT_STYLE_ITALIC: v = "italic"; break;
	case CSS_FONT_STYLE_OBLIQUE: v = "oblique"; break;
	default: v = "normal"; break;
	}
	dukky_window_style_put(ctx, "font-style", v);

	switch (css_computed_font_weight(style)) {
	case CSS_FONT_WEIGHT_BOLD: v = "bold"; break;
	case CSS_FONT_WEIGHT_BOLDER: v = "bolder"; break;
	case CSS_FONT_WEIGHT_LIGHTER: v = "lighter"; break;
	case CSS_FONT_WEIGHT_100: v = "100"; break;
	case CSS_FONT_WEIGHT_200: v = "200"; break;
	case CSS_FONT_WEIGHT_300: v = "300"; break;
	case CSS_FONT_WEIGHT_400: v = "400"; break;
	case CSS_FONT_WEIGHT_500: v = "500"; break;
	case CSS_FONT_WEIGHT_600: v = "600"; break;
	case CSS_FONT_WEIGHT_700: v = "700"; break;
	case CSS_FONT_WEIGHT_800: v = "800"; break;
	case CSS_FONT_WEIGHT_900: v = "900"; break;
	default: v = "normal"; break;
	}
	dukky_window_style_put(ctx, "font-weight", v);

	switch (css_computed_line_height(style, &len, &unit)) {
	case CSS_LINE_HEIGHT_NUMBER:
		dukky_window_fmt_num(nbuf, sizeof nbuf, ((double)len) / 256.0);
		dukky_window_style_put(ctx, "line-height", nbuf);
		break;
	case CSS_LINE_HEIGHT_DIMENSION:
		dukky_window_push_dim(ctx, "line-height", len, unit);
		break;
	default:
		dukky_window_style_put(ctx, "line-height", "normal");
		break;
	}

	switch (css_computed_letter_spacing(style, &len, &unit)) {
	case CSS_LETTER_SPACING_SET:
		dukky_window_push_dim(ctx, "letter-spacing", len, unit);
		break;
	default:
		dukky_window_style_put(ctx, "letter-spacing", "normal");
		break;
	}

	switch (css_computed_text_align(style)) {
	case CSS_TEXT_ALIGN_LEFT:
	case CSS_TEXT_ALIGN_LIBCSS_LEFT:
		v = "left";
		break;
	case CSS_TEXT_ALIGN_RIGHT:
	case CSS_TEXT_ALIGN_LIBCSS_RIGHT:
		v = "right";
		break;
	case CSS_TEXT_ALIGN_CENTER:
	case CSS_TEXT_ALIGN_LIBCSS_CENTER:
		v = "center";
		break;
	case CSS_TEXT_ALIGN_JUSTIFY:
		v = "justify";
		break;
	default:
		v = "start";
		break;
	}
	dukky_window_style_put(ctx, "text-align", v);

	td = css_computed_text_decoration(style);
	buf[0] = '\0';
	if (td & CSS_TEXT_DECORATION_UNDERLINE) {
		strncat(buf, "underline", sizeof buf - strlen(buf) - 1);
	}
	if (td & CSS_TEXT_DECORATION_OVERLINE) {
		if (buf[0] != '\0') {
			strncat(buf, " ", sizeof buf - strlen(buf) - 1);
		}
		strncat(buf, "overline", sizeof buf - strlen(buf) - 1);
	}
	if (td & CSS_TEXT_DECORATION_LINE_THROUGH) {
		if (buf[0] != '\0') {
			strncat(buf, " ", sizeof buf - strlen(buf) - 1);
		}
		strncat(buf, "line-through", sizeof buf - strlen(buf) - 1);
	}
	if (td & CSS_TEXT_DECORATION_BLINK) {
		if (buf[0] != '\0') {
			strncat(buf, " ", sizeof buf - strlen(buf) - 1);
		}
		strncat(buf, "blink", sizeof buf - strlen(buf) - 1);
	}
	dukky_window_style_put(ctx, "text-decoration",
			buf[0] == '\0' ? "none" : buf);

	switch (css_computed_text_transform(style)) {
	case CSS_TEXT_TRANSFORM_CAPITALIZE: v = "capitalize"; break;
	case CSS_TEXT_TRANSFORM_UPPERCASE: v = "uppercase"; break;
	case CSS_TEXT_TRANSFORM_LOWERCASE: v = "lowercase"; break;
	default: v = "none"; break;
	}
	dukky_window_style_put(ctx, "text-transform", v);

	if (css_computed_text_indent(style, &len, &unit) == CSS_TEXT_INDENT_SET) {
		dukky_window_push_dim(ctx, "text-indent", len, unit);
	} else {
		dukky_window_style_put(ctx, "text-indent", "0px");
	}

	dukky_window_style_put(ctx, "display",
			dukky_window_display_str(css_computed_display(style, root_el)));

	switch (css_computed_position(style)) {
	case CSS_POSITION_RELATIVE: v = "relative"; break;
	case CSS_POSITION_ABSOLUTE: v = "absolute"; break;
	case CSS_POSITION_FIXED: v = "fixed"; break;
	case CSS_POSITION_STICKY: v = "sticky"; break;
	default: v = "static"; break;
	}
	dukky_window_style_put(ctx, "position", v);

	switch (css_computed_float(style)) {
	case CSS_FLOAT_LEFT: v = "left"; break;
	case CSS_FLOAT_RIGHT: v = "right"; break;
	default: v = "none"; break;
	}
	dukky_window_style_put(ctx, "float", v);

	switch (css_computed_clear(style)) {
	case CSS_CLEAR_LEFT: v = "left"; break;
	case CSS_CLEAR_RIGHT: v = "right"; break;
	case CSS_CLEAR_BOTH: v = "both"; break;
	default: v = "none"; break;
	}
	dukky_window_style_put(ctx, "clear", v);

	switch (css_computed_visibility(style)) {
	case CSS_VISIBILITY_HIDDEN: v = "hidden"; break;
	case CSS_VISIBILITY_COLLAPSE: v = "collapse"; break;
	default: v = "visible"; break;
	}
	dukky_window_style_put(ctx, "visibility", v);

	switch (css_computed_direction(style)) {
	case CSS_DIRECTION_RTL: v = "rtl"; break;
	default: v = "ltr"; break;
	}
	dukky_window_style_put(ctx, "direction", v);

	switch (css_computed_white_space(style)) {
	case CSS_WHITE_SPACE_PRE: v = "pre"; break;
	case CSS_WHITE_SPACE_NOWRAP: v = "nowrap"; break;
	case CSS_WHITE_SPACE_PRE_WRAP: v = "pre-wrap"; break;
	case CSS_WHITE_SPACE_PRE_LINE: v = "pre-line"; break;
	default: v = "normal"; break;
	}
	dukky_window_style_put(ctx, "white-space", v);

	switch (css_computed_overflow_x(style)) {
	case CSS_OVERFLOW_HIDDEN: v = "hidden"; break;
	case CSS_OVERFLOW_SCROLL: v = "scroll"; break;
	case CSS_OVERFLOW_AUTO: v = "auto"; break;
	default: v = "visible"; break;
	}
	dukky_window_style_put(ctx, "overflow-x", v);

	switch (css_computed_overflow_y(style)) {
	case CSS_OVERFLOW_HIDDEN: v = "hidden"; break;
	case CSS_OVERFLOW_SCROLL: v = "scroll"; break;
	case CSS_OVERFLOW_AUTO: v = "auto"; break;
	default: v = "visible"; break;
	}
	dukky_window_style_put(ctx, "overflow-y", v);

	dukky_window_style_put(ctx, "box-sizing",
			css_computed_box_sizing(style) == CSS_BOX_SIZING_BORDER_BOX ?
			"border-box" : "content-box");

	if (css_computed_z_index(style, &zi) == CSS_Z_INDEX_SET) {
		snprintf(nbuf, sizeof nbuf, "%d", (int)zi);
		dukky_window_style_put(ctx, "z-index", nbuf);
	} else {
		dukky_window_style_put(ctx, "z-index", "auto");
	}

	if (css_computed_opacity(style, &op) == CSS_OPACITY_SET) {
		dukky_window_fmt_num(nbuf, sizeof nbuf, ((double)op) / 256.0);
		dukky_window_style_put(ctx, "opacity", nbuf);
	} else {
		dukky_window_style_put(ctx, "opacity", "1");
	}

	if (css_computed_top(style, &len, &unit) == CSS_TOP_SET) {
		dukky_window_push_dim(ctx, "top", len, unit);
	} else {
		dukky_window_style_put(ctx, "top", "auto");
	}
	if (css_computed_right(style, &len, &unit) == CSS_TOP_SET) {
		dukky_window_push_dim(ctx, "right", len, unit);
	} else {
		dukky_window_style_put(ctx, "right", "auto");
	}
	if (css_computed_bottom(style, &len, &unit) == CSS_TOP_SET) {
		dukky_window_push_dim(ctx, "bottom", len, unit);
	} else {
		dukky_window_style_put(ctx, "bottom", "auto");
	}
	if (css_computed_left(style, &len, &unit) == CSS_TOP_SET) {
		dukky_window_push_dim(ctx, "left", len, unit);
	} else {
		dukky_window_style_put(ctx, "left", "auto");
	}

	if (css_computed_width(style, &len, &unit) == CSS_WIDTH_SET) {
		dukky_window_push_dim(ctx, "width", len, unit);
	} else {
		dukky_window_style_put(ctx, "width", "auto");
	}
	if (css_computed_height(style, &len, &unit) == CSS_HEIGHT_SET) {
		dukky_window_push_dim(ctx, "height", len, unit);
	} else {
		dukky_window_style_put(ctx, "height", "auto");
	}
	if (css_computed_min_width(style, &len, &unit) == CSS_PADDING_SET) {
		dukky_window_push_dim(ctx, "min-width", len, unit);
	} else {
		dukky_window_style_put(ctx, "min-width", "0px");
	}
	if (css_computed_min_height(style, &len, &unit) == CSS_PADDING_SET) {
		dukky_window_push_dim(ctx, "min-height", len, unit);
	} else {
		dukky_window_style_put(ctx, "min-height", "0px");
	}
	if (css_computed_max_width(style, &len, &unit) == CSS_PADDING_SET) {
		dukky_window_push_dim(ctx, "max-width", len, unit);
	} else {
		dukky_window_style_put(ctx, "max-width", "none");
	}
	if (css_computed_max_height(style, &len, &unit) == CSS_PADDING_SET) {
		dukky_window_push_dim(ctx, "max-height", len, unit);
	} else {
		dukky_window_style_put(ctx, "max-height", "none");
	}

	switch (css_computed_margin_top(style, &len, &unit)) {
	case CSS_MARGIN_SET: dukky_window_push_dim(ctx, "margin-top", len, unit); break;
	case CSS_MARGIN_AUTO: dukky_window_style_put(ctx, "margin-top", "auto"); break;
	default: dukky_window_style_put(ctx, "margin-top", "0px"); break;
	}
	switch (css_computed_margin_right(style, &len, &unit)) {
	case CSS_MARGIN_SET: dukky_window_push_dim(ctx, "margin-right", len, unit); break;
	case CSS_MARGIN_AUTO: dukky_window_style_put(ctx, "margin-right", "auto"); break;
	default: dukky_window_style_put(ctx, "margin-right", "0px"); break;
	}
	switch (css_computed_margin_bottom(style, &len, &unit)) {
	case CSS_MARGIN_SET: dukky_window_push_dim(ctx, "margin-bottom", len, unit); break;
	case CSS_MARGIN_AUTO: dukky_window_style_put(ctx, "margin-bottom", "auto"); break;
	default: dukky_window_style_put(ctx, "margin-bottom", "0px"); break;
	}
	switch (css_computed_margin_left(style, &len, &unit)) {
	case CSS_MARGIN_SET: dukky_window_push_dim(ctx, "margin-left", len, unit); break;
	case CSS_MARGIN_AUTO: dukky_window_style_put(ctx, "margin-left", "auto"); break;
	default: dukky_window_style_put(ctx, "margin-left", "0px"); break;
	}

	if (css_computed_padding_top(style, &len, &unit) == CSS_PADDING_SET) {
		dukky_window_push_dim(ctx, "padding-top", len, unit);
	} else {
		dukky_window_style_put(ctx, "padding-top", "0px");
	}
	if (css_computed_padding_right(style, &len, &unit) == CSS_PADDING_SET) {
		dukky_window_push_dim(ctx, "padding-right", len, unit);
	} else {
		dukky_window_style_put(ctx, "padding-right", "0px");
	}
	if (css_computed_padding_bottom(style, &len, &unit) == CSS_PADDING_SET) {
		dukky_window_push_dim(ctx, "padding-bottom", len, unit);
	} else {
		dukky_window_style_put(ctx, "padding-bottom", "0px");
	}
	if (css_computed_padding_left(style, &len, &unit) == CSS_PADDING_SET) {
		dukky_window_push_dim(ctx, "padding-left", len, unit);
	} else {
		dukky_window_style_put(ctx, "padding-left", "0px");
	}

	dukky_window_border_width(ctx, "border-top-width",
			css_computed_border_top_width(style, &len, &unit), len, unit);
	dukky_window_border_width(ctx, "border-right-width",
			css_computed_border_right_width(style, &len, &unit), len, unit);
	dukky_window_border_width(ctx, "border-bottom-width",
			css_computed_border_bottom_width(style, &len, &unit), len, unit);
	dukky_window_border_width(ctx, "border-left-width",
			css_computed_border_left_width(style, &len, &unit), len, unit);

	dukky_window_style_put(ctx, "border-top-style",
			dukky_window_border_style_str(css_computed_border_top_style(style)));
	dukky_window_style_put(ctx, "border-right-style",
			dukky_window_border_style_str(css_computed_border_right_style(style)));
	dukky_window_style_put(ctx, "border-bottom-style",
			dukky_window_border_style_str(css_computed_border_bottom_style(style)));
	dukky_window_style_put(ctx, "border-left-style",
			dukky_window_border_style_str(css_computed_border_left_style(style)));

	if (css_computed_border_top_color(style, &col) == CSS_BORDER_COLOR_COLOR) {
		dukky_window_push_color(ctx, "border-top-color", col);
	} else {
		dukky_window_style_put(ctx, "border-top-color", "currentcolor");
	}
	if (css_computed_border_right_color(style, &col) == CSS_BORDER_COLOR_COLOR) {
		dukky_window_push_color(ctx, "border-right-color", col);
	} else {
		dukky_window_style_put(ctx, "border-right-color", "currentcolor");
	}
	if (css_computed_border_bottom_color(style, &col) == CSS_BORDER_COLOR_COLOR) {
		dukky_window_push_color(ctx, "border-bottom-color", col);
	} else {
		dukky_window_style_put(ctx, "border-bottom-color", "currentcolor");
	}
	if (css_computed_border_left_color(style, &col) == CSS_BORDER_COLOR_COLOR) {
		dukky_window_push_color(ctx, "border-left-color", col);
	} else {
		dukky_window_style_put(ctx, "border-left-color", "currentcolor");
	}

	duk_push_c_function(ctx, dukky_window_style_get_prop, 1);
	duk_put_prop_string(ctx, -2, "getPropertyValue");
	duk_push_c_function(ctx, dukky_window_style_get_prio, 0);
	duk_put_prop_string(ctx, -2, "getPropertyPriority");
	dukky_window_style_put(ctx, "cssText", "");

	css_select_results_destroy(prev);
	if (prev != rootres && rootres != NULL) {
		css_select_results_destroy(rootres);
	}
	return 1;
%}

